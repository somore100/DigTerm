{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digterm",
  "version": "0.0.1",
  "identifier": "dev.digterm.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Digterm", "width": 1000, "height": 680, "minWidth": 520, "minHeight": 340 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A terminal that helps you understand large command output",
    "longDescription": "Digterm is a terminal with an analysis layer: per-command output blocks, search, folding of repeated lines, and a viewer built for very large outputs.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
